# Copy to .env and fill in. `make secrets` prints fresh values for the secret fields.
# Never commit .env.

# LLM provider: anthropic | openai | fake  (fake = offline demo and tests only)
LLM_PROVIDER=anthropic
# e.g. claude-sonnet-5-5 for anthropic, gpt-4.1-mini for openai
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (Azure OpenAI, vLLM, Ollama...)
OPENAI_BASE_URL=

# Secrets (required)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 64+ random characters
JWT_SECRET=
# Fernet key(s), comma separated. The first one encrypts; all of them decrypt.
# To rotate: put a new key first, keep the old one after it.
DATA_ENCRYPTION_KEYS=

# Secure cookies. Browsers accept them on http://localhost, so keep this true
# unless you serve the app over plain HTTP on another hostname.
COOKIE_SECURE=true
APP_ENV=production
WEB_PORT=8080
WEB_CONCURRENCY=4
LOG_LEVEL=INFO
